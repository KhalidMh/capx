{
  "name": "@khalidmh/capx",
  "version": "0.1.0",
  "description": "An opinionated installer for SAP CAP Node.js projects.",
  "license": "MIT",
  "keywords": [
    "sap-cap",
    "cap",
    "cds",
    "cloud-application-programming",
    "scaffolding"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KhalidMh/capx.git"
  },
  "bugs": {
    "url": "https://github.com/KhalidMh/capx/issues"
  },
  "homepage": "https://github.com/KhalidMh/capx#readme",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "bin/",
    "src/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "package.json"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "capx": "bin/capx.js"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch:required": "node test/e2e/run-required-cds-watch.js",
    "test:frontend:required": "node test/e2e/run-required-frontend.js",
    "test:mta:required": "node test/e2e/run-required-mta.js",
    "test:docker:required": "node test/e2e/run-required-docker.js",
    "test:vue-no-auth:required": "node test/e2e/run-required-vue-no-auth.js",
    "test:install-git:required": "node test/e2e/run-required-install-git.js"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "commander": "^15.0.0",
    "execa": "^10.0.1",
    "picocolors": "^1.1.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "vitest": "^4.1.10"
  }
}
